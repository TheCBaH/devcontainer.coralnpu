+int CoralNPUSimulator::ExitStatus() {
+  if (htif_semihost_ && htif_semihost_->exit_code().has_value()) {
+    return htif_semihost_->exit_code().value() & 0xff;
+  }
+  auto reason = top_->GetLastHaltReason();
+  if (!reason.ok()) return 126;
+  if (!ebreak_halt_ && *reason == *HaltReason::kUserRequest) return 0;
+  return 125;
+}
+
 absl::Status CoralNPUSimulator::Run() { return top_->Run(); }
 
