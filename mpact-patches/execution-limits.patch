+absl::StatusOr<CoralNPUSimulator::BatchResult> CoralNPUSimulator::RunBatch(
+    uint64_t max_instructions,
+    const volatile std::sig_atomic_t* interrupted) {
+  uint64_t executed = 0;
+  auto finish = [this, &executed](const char* reason, int status)
+      -> absl::StatusOr<BatchResult> {
+    auto pc = top_->ReadRegister("pc");
+    if (!pc.ok()) return pc.status();
+    return BatchResult{reason, status, executed, *pc};
+  };
+  mpause_halt_ = false;
+  ebreak_halt_ = false;
+  while (true) {
+    if (interrupted != nullptr && *interrupted) {
+      return finish("interrupted", 130);
+    }
+    if (max_instructions != 0 && executed == max_instructions) {
+      return finish("instruction_limit", 124);
+    }
+    // Small chunks bound signal-response latency without another thread.
+    uint64_t count = 65536;
+    if (max_instructions != 0) {
+      count = std::min(count, max_instructions - executed);
+    }
+    auto steps = Step(static_cast<int>(count));
+    if (!steps.ok()) return steps.status();
+    if (*steps <= 0 || static_cast<uint64_t>(*steps) > count ||
+        static_cast<uint64_t>(*steps) >
+            std::numeric_limits<uint64_t>::max() - executed) {
+      return absl::InternalError("Invalid batch step count");
+    }
+    executed += *steps;
+    auto reason = top_->GetLastHaltReason();
+    if (!reason.ok()) return reason.status();
+    // A guest halt on the last permitted instruction wins over the limit.
+    if (*reason != *HaltReason::kNone) {
+      if (htif_semihost_ && htif_semihost_->exit_code().has_value()) {
+        return finish("guest_exit", ExitStatus());
+      }
+      if (mpause_halt_) return finish("mpause", 0);
+      if (ebreak_halt_) return finish("ebreak", 125);
+      return finish("halted", 125);
+    }
+  }
+}
+
 absl::Status CoralNPUSimulator::Run() { return top_->Run(); }
 
 absl::StatusOr<int> CoralNPUSimulator::Step(int num_steps) {
