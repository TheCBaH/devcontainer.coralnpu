diff --git a/tests/verilator_sim/fd_vcd_file.h b/tests/verilator_sim/fd_vcd_file.h
new file mode 100644
index 0000000..0a9930d
--- /dev/null
+++ b/tests/verilator_sim/fd_vcd_file.h
@@ -0,0 +1,62 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef TESTS_VERILATOR_SIM_FD_VCD_FILE_H_
+#define TESTS_VERILATOR_SIM_FD_VCD_FILE_H_
+
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "verilated_vcd_c.h"  // NOLINT(build/include_subdir): From verilator.
+
+// A VCD output on a descriptor the caller owns, typically a pipe to a consumer that reads as the
+// simulation runs. Verilator's own VerilatedVcdFile opens its file non-blocking and retries a full
+// pipe at once, so a slow consumer makes the simulator spin; this one makes the descriptor blocking
+// and waits in write(2). If the consumer goes away, the simulation ends with status 141.
+class FdVcdFile : public VerilatedVcdFile {
+ public:
+  explicit FdVcdFile(int fd) : fd_(fd) {}
+
+  // Returns false if [fd] is not a descriptor or cannot be made blocking.
+  bool Prepare() {
+    const int flags = fcntl(fd_, F_GETFL);
+    return flags >= 0 && fcntl(fd_, F_SETFL, flags & ~O_NONBLOCK) == 0;
+  }
+
+  bool open(const std::string&) override { return true; }
+  void close() override {}  // The descriptor is the caller's; its end is the consumer's end of input.
+
+  ssize_t write(const char *bufp, ssize_t len) override {
+    for (;;) {
+      const ssize_t got = ::write(fd_, bufp, len);
+      if (got >= 0) return got;
+      if (errno == EINTR) continue;
+      if (errno == EPIPE) {
+        fprintf(stderr, "trace_fd: the consumer closed the trace\n");
+        std::_Exit(141);
+      }
+      return got;  // Verilator reports any other error as fatal.
+    }
+  }
+
+ private:
+  int fd_;
+};
+
+#endif  // TESTS_VERILATOR_SIM_FD_VCD_FILE_H_
diff --git a/tests/verilator_sim/fd_vcd_file_test.cc b/tests/verilator_sim/fd_vcd_file_test.cc
new file mode 100644
index 0000000..7ff3f3a
--- /dev/null
+++ b/tests/verilator_sim/fd_vcd_file_test.cc
@@ -0,0 +1,103 @@
+// Copyright 2026 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// FdVcdFile on a pipe whose reader is slow: the writer waits in write(2) instead of spinning, and
+// loses nothing; a reader that goes away ends the process with status 141.
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <string>
+
+#include "tests/verilator_sim/fd_vcd_file.h"
+
+namespace {
+
+int failures = 0;
+
+void Check(bool ok, const std::string &what) {
+  printf("%s: %s\n", ok ? "ok  " : "FAIL", what.c_str());
+  if (!ok) ++failures;
+}
+
+double CpuSeconds() {
+  rusage usage;
+  getrusage(RUSAGE_SELF, &usage);
+  return usage.ru_utime.tv_sec + usage.ru_stime.tv_sec +
+         (usage.ru_utime.tv_usec + usage.ru_stime.tv_usec) * 1e-6;
+}
+
+}  // namespace
+
+int main() {
+  // 1 MiB through a pipe (64 KiB) to a reader that sleeps for 2 s before it reads at all.
+  constexpr size_t kBytes = 1 << 20;
+  int fds[2];
+  if (pipe(fds) != 0) return 2;
+  const pid_t reader = fork();
+  if (reader == 0) {
+    close(fds[1]);
+    sleep(2);
+    char buf[4096];
+    size_t total = 0;
+    ssize_t got;
+    while ((got = read(fds[0], buf, sizeof buf)) > 0) total += got;
+    _exit(total == kBytes ? 0 : 1);
+  }
+  close(fds[0]);
+
+  FdVcdFile file(fds[1]);
+  Check(file.Prepare(), "the descriptor is made blocking");
+  Check(file.open("ignored"), "open takes the descriptor as it is");
+  const std::string chunk(8192, 'x');
+  const auto start = std::chrono::steady_clock::now();
+  const double cpu_start = CpuSeconds();
+  size_t sent = 0;
+  while (sent < kBytes) {
+    const ssize_t got = file.write(chunk.data(), chunk.size());
+    if (got < 0) break;
+    sent += got;
+  }
+  const double waited =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+  const double cpu = CpuSeconds() - cpu_start;
+  file.close();
+  close(fds[1]);
+  int status = 0;
+  waitpid(reader, &status, 0);
+  Check(sent == kBytes, "everything is written");
+  Check(WIFEXITED(status) && WEXITSTATUS(status) == 0, "and read, in order of arrival");
+  Check(waited > 1.5, "the writer waited for the reader (" + std::to_string(waited) + " s)");
+  Check(cpu < 0.5, "and did not spin (" + std::to_string(cpu) + " s of CPU)");
+
+  // The reader goes away: the process ends with 141, without a failure report from Verilator.
+  if (pipe(fds) != 0) return 2;
+  const pid_t writer = fork();
+  if (writer == 0) {
+    close(fds[0]);
+    FdVcdFile gone(fds[1]);
+    signal(SIGPIPE, SIG_IGN);
+    for (;;) gone.write(chunk.data(), chunk.size());
+  }
+  close(fds[0]);
+  close(fds[1]);
+  waitpid(writer, &status, 0);
+  Check(WIFEXITED(status) && WEXITSTATUS(status) == 141, "a closed reader ends the writer with 141");
+
+  printf("%d failures\n", failures);
+  return failures == 0 ? 0 : 1;
+}
