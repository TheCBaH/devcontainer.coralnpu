new file mode 100644
index 0000000..99c6119
--- /dev/null
+++ b/tests/trace_selection/trace_selection_test.cc
@@ -0,0 +1,249 @@
+// Exact-name trace selection (Verilator patch 0003), exercised on the real trace runtime the way
+// generated code drives it: declarations in an init callback, values in full and change callbacks.
+// The VCD output is read back and compared with the full trace; for FST the checks are that the
+// runtime accepts the selection and that unmatched names are reported. Built with
+// --config=glibcxx-debug, so an out-of-range enable-mask read aborts.
+#include <sys/stat.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#include "verilated_fst_c.h"  // NOLINT(build/include_subdir): From verilator.
+#include "verilated_vcd_c.h"  // NOLINT(build/include_subdir): From verilator.
+
+namespace {
+
+// Signals s0..s(n-1) at codes 1..n, and an event at code n + 1, in scopes "top" / "core.x".
+struct Model {
+  VlEvent event;
+  int signals = 0;
+  int step = 0;
+};
+
+int Value(const Model* m, int i) { return ((m->step >> (i % 7)) ^ i) & 1; }
+
+void DeclBit(VerilatedVcd* t, uint32_t code, const char* name) { t->declBit(code, name); }
+void DeclBit(VerilatedFst* t, uint32_t code, const char* name) {
+  t->declBit(code, name, -1, VerilatedTraceSigDirection::NONE, VerilatedTraceSigKind::WIRE,
+             VerilatedTraceSigType::LOGIC);
+}
+void DeclEvent(VerilatedVcd* t, uint32_t code, const char* name) { t->declEvent(code, name); }
+void DeclEvent(VerilatedFst* t, uint32_t code, const char* name) {
+  t->declEvent(code, name, -1, VerilatedTraceSigDirection::NONE, VerilatedTraceSigKind::WIRE,
+               VerilatedTraceSigType::EVENT);
+}
+
+template <typename Trace>
+void InitCb(void* userp, Trace* tracep, uint32_t) {
+  auto* m = static_cast<Model*>(userp);
+  static std::vector<std::string> names;
+  names.clear();
+  for (int i = 0; i < m->signals; ++i) names.push_back("s" + std::to_string(i));
+  tracep->pushPrefix("top", VerilatedTracePrefixType::SCOPE_MODULE);
+  tracep->pushPrefix("core.x", VerilatedTracePrefixType::SCOPE_MODULE);
+  for (int i = 0; i < m->signals; ++i) DeclBit(tracep, 1 + i, names[i].c_str());
+  DeclEvent(tracep, 1 + m->signals, "ev");
+  tracep->popPrefix();
+  tracep->popPrefix();
+}
+
+template <typename Trace>
+void FullCb(void* userp, typename Trace::Buffer* bufp) {
+  auto* m = static_cast<Model*>(userp);
+  for (int i = 0; i < m->signals; ++i) bufp->fullBit(bufp->oldp(1 + i), Value(m, i));
+  bufp->fullEvent(bufp->oldp(1 + m->signals), &m->event);
+}
+
+// Both event emitters of generated code: a triggered event by pointer, and the unconditional one.
+template <typename Trace>
+void ChgCb(void* userp, typename Trace::Buffer* bufp) {
+  auto* m = static_cast<Model*>(userp);
+  for (int i = 0; i < m->signals; ++i) bufp->chgBit(bufp->oldp(1 + i), Value(m, i));
+  if (m->step % 3 == 0) bufp->chgEventTriggered(bufp->oldp(1 + m->signals));
+  if (m->step % 3 == 1) {
+    m->event.fire();
+    bufp->chgEvent(bufp->oldp(1 + m->signals), &m->event);
+    m->event.clearTriggered();
+  }
+}
+
+enum class Mode { kTrace, kCatalog };
+
+// Writes a trace of [signals] bits and the event over [steps] time steps with the given selection.
+// Returns the names the open did not declare.
+template <typename Tfp, typename Trace>
+std::vector<std::string> Write(const std::string& path, int signals, int steps,
+                               const std::vector<std::string>& select, Mode mode = Mode::kTrace) {
+  Model model;
+  model.signals = signals;
+  Tfp tfp;
+  tfp.spTrace()->addInitCb(&InitCb<Trace>, &model, "top", false, signals + 1);
+  tfp.spTrace()->addFullCb(&FullCb<Trace>, 0, &model);
+  tfp.spTrace()->addChgCb(&ChgCb<Trace>, 0, &model);
+  tfp.modelConnected(true);
+  for (const auto& name : select) tfp.dumpvarsExact(name);
+  tfp.open(path.c_str());
+  auto unmatched = tfp.dumpvarsUnmatched();
+  if (unmatched.empty() && mode == Mode::kTrace) {
+    for (model.step = 0; model.step < steps; ++model.step) tfp.dump(model.step);
+  }
+  tfp.close();
+  return unmatched;
+}
+
+std::vector<std::string> WriteVcd(const std::string& path, int signals, int steps,
+                                  const std::vector<std::string>& select,
+                                  Mode mode = Mode::kTrace) {
+  return Write<VerilatedVcdC, VerilatedVcd>(path, signals, steps, select, mode);
+}
+
+std::vector<std::string> WriteFst(const std::string& path, int signals, int steps,
+                                  const std::vector<std::string>& select,
+                                  Mode mode = Mode::kTrace) {
+  return Write<VerilatedFstC, VerilatedFst>(path, signals, steps, select, mode);
+}
+
+struct Vcd {
+  std::vector<std::string> declared;  // Native names, in declaration order.
+  // (time, native name, value line) for each change after $enddefinitions.
+  std::vector<std::tuple<uint64_t, std::string, std::string>> changes;
+  bool complete = false;  // $enddefinitions seen.
+};
+
+Vcd Read(const std::string& path) {
+  Vcd vcd;
+  std::ifstream in(path);
+  std::map<std::string, std::string> names;  // id -> native name
+  std::vector<std::string> scopes;
+  std::string line;
+  uint64_t time = 0;
+  while (std::getline(in, line)) {
+    std::istringstream words(line);
+    std::string first;
+    if (!(words >> first)) continue;
+    if (!vcd.complete) {
+      if (first == "$scope") {
+        std::string kind, name;
+        words >> kind >> name;
+        scopes.push_back(name);
+      } else if (first == "$upscope") {
+        scopes.pop_back();
+      } else if (first == "$var") {
+        std::string type, size, id, name;
+        words >> type >> size >> id >> name;
+        std::string native;
+        for (const auto& s : scopes) native += s + " ";
+        native += name;
+        names[id] = native;
+        vcd.declared.push_back(native);
+      } else if (first == "$enddefinitions") {
+        vcd.complete = true;
+      }
+      continue;
+    }
+    if (first[0] == '#') {
+      time = std::stoull(first.substr(1));
+    } else {
+      const std::string id = first.substr(1);
+      const auto it = names.find(id);
+      vcd.changes.emplace_back(time, it == names.end() ? "?" + id : it->second, first.substr(0, 1));
+    }
+  }
+  return vcd;
+}
+
+long Size(const std::string& path) {
+  struct stat st;
+  return stat(path.c_str(), &st) == 0 ? static_cast<long>(st.st_size) : -1;
+}
+
+int failures = 0;
+
+void Check(bool ok, const std::string& what) {
+  std::printf("%s: %s\n", ok ? "ok  " : "FAIL", what.c_str());
+  if (!ok) ++failures;
+}
+
+bool Selected(const std::vector<std::string>& select, const std::string& name) {
+  for (const auto& s : select) {
+    if (s == name) return true;
+  }
+  return false;
+}
+
+// The selected VCD declares exactly [select], and its changes are those of the full VCD for
+// those names, in order.
+void CheckVcdSelection(const std::string& what, const std::string& dir, int signals, int steps,
+                       const std::vector<std::string>& select) {
+  const std::string full_path = dir + "/full.vcd", sel_path = dir + "/selected.vcd";
+  Check(WriteVcd(full_path, signals, steps, {}).empty(), what + ": full trace written");
+  Check(WriteVcd(sel_path, signals, steps, select).empty(), what + ": selection matched");
+  const Vcd full = Read(full_path), sel = Read(sel_path);
+  Check(sel.complete, what + ": header complete");
+  std::vector<std::string> want;
+  for (const auto& d : full.declared) {
+    if (Selected(select, d)) want.push_back(d);
+  }
+  Check(sel.declared == want, what + ": declares exactly the selection (" +
+                                  std::to_string(sel.declared.size()) + " of " +
+                                  std::to_string(full.declared.size()) + ")");
+  std::vector<std::tuple<uint64_t, std::string, std::string>> expected;
+  for (const auto& c : full.changes) {
+    if (Selected(select, std::get<1>(c))) expected.push_back(c);
+  }
+  Check(sel.changes == expected, what + ": changes are those of the full trace (" +
+                                     std::to_string(sel.changes.size()) + ")");
+  Check(!expected.empty(), what + ": the selection changes at least once");
+}
+
+}  // namespace
+
+extern "C" int sc_main(int, char**) {
+  const char* tmp = std::getenv("TEST_TMPDIR");
+  const std::string dir = tmp != nullptr ? tmp : "/tmp";
+
+  CheckVcdSelection("VCD bits and event", dir, 20, 12, {"top core.x s3", "top core.x s4", "top core.x ev"});
+  // The event is triggered at steps the selection does not cover: no record may reach the writer.
+  CheckVcdSelection("VCD event unselected", dir, 20, 12, {"top core.x s4", "top core.x s5"});
+  CheckVcdSelection("VCD dotted scope, not a prefix", dir, 20, 12, {"top core.x s1"});
+  // The last selected code is far below the last declared one: the mask must be sized for all.
+  CheckVcdSelection("VCD sparse", dir, 5000, 8, {"top core.x s0"});
+
+  const std::vector<std::string> missing = {"top core.x s1", "top core.x nope", "top core x s2"};
+  const auto vcd_missing = WriteVcd(dir + "/m.vcd", 20, 4, missing);
+  Check(vcd_missing.size() == 2, "VCD unmatched names are reported");
+  const auto fst_missing = WriteFst(dir + "/m.fst", 20, 4, missing);
+  Check(fst_missing.size() == 2, "FST unmatched names are reported");
+
+  // A prefix is not a selection: dumpvars would also take what is under "top core.x".
+  const auto prefix = WriteVcd(dir + "/p.vcd", 20, 4, {"top core.x"});
+  Check(prefix.size() == 1, "VCD a scope name selects nothing");
+
+  // Catalog: open and close, no dump.
+  Check(WriteVcd(dir + "/c.vcd", 20, 4, {}, Mode::kCatalog).empty(), "VCD catalog written");
+  const Vcd catalog = Read(dir + "/c.vcd");
+  Check(catalog.complete && catalog.declared.size() == 21 && catalog.changes.empty(),
+        "VCD catalog declares everything and has no changes");
+  Check(WriteFst(dir + "/c.fst", 20, 4, {}, Mode::kCatalog).empty(), "FST catalog written");
+  Check(Size(dir + "/c.fst") > 0, "FST catalog is not empty");
+
+  // FST: the runtime takes the same selections, in debug mode, and writes less.
+  Check(WriteFst(dir + "/full.fst", 200, 12, {}).empty(), "FST full trace written");
+  Check(WriteFst(dir + "/selected.fst", 200, 12, {"top core.x s3", "top core.x ev"}).empty(),
+        "FST selection with the event matched");
+  Check(WriteFst(dir + "/noevent.fst", 200, 12, {"top core.x s3"}).empty(),
+        "FST selection without the event matched");
+  Check(WriteFst(dir + "/sparse.fst", 5000, 8, {"top core.x s0"}).empty(), "FST sparse selection");
+  Check(Size(dir + "/selected.fst") > 0 && Size(dir + "/selected.fst") < Size(dir + "/full.fst"),
+        "FST selected trace is smaller than the full trace");
+
+  std::printf("%d failures\n", failures);
+  return failures == 0 ? 0 : 1;
+}
