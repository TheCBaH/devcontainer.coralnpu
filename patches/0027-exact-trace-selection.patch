+
+// Sysc_tb::trace with a selection, and as a catalog, on a stand-in for a Verilated design: the
+// manifest reader, the fatal unmatched name, and the files each mode leaves.
+#include <sys/stat.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "tests/verilator_sim/sysc_tb.h"
+
+namespace {
+
+constexpr int kSignals = 300;
+
+// A design that declares kSignals one-bit signals under the scopes "VFake.core" and "Fake", the way
+// a Verilated model's trace callbacks do.
+struct Design {
+  const char *name() const { return "fake"; }
+
+  void trace(VerilatedFstC *tfp, int) {
+    tfp->spTrace()->addInitCb(&Init, this, "VFake", false, kSignals);
+    tfp->spTrace()->addFullCb(&Full, 0, this);
+    tfp->spTrace()->addChgCb(&Full, 0, this);
+    tfp->modelConnected(true);
+  }
+
+  static void Init(void *, VerilatedFst *tracep, uint32_t) {
+    static std::vector<std::string> names;
+    names.clear();
+    for (int i = 0; i < kSignals; ++i) names.push_back("s" + std::to_string(i));
+    tracep->pushPrefix("VFake.core", VerilatedTracePrefixType::SCOPE_MODULE);
+    tracep->pushPrefix("Fake", VerilatedTracePrefixType::SCOPE_MODULE);
+    for (int i = 0; i < kSignals; ++i) {
+      tracep->declBit(1 + i, names[i].c_str(), -1, VerilatedTraceSigDirection::NONE,
+                      VerilatedTraceSigKind::WIRE, VerilatedTraceSigType::LOGIC);
+    }
+    tracep->popPrefix();
+    tracep->popPrefix();
+  }
+
+  static void Full(void *userp, VerilatedFst::Buffer *bufp) {
+    for (int i = 0; i < kSignals; ++i) bufp->fullBit(bufp->oldp(1 + i), i & 1);
+  }
+};
+
+struct Tb : public Sysc_tb {
+  explicit Tb(sc_module_name name) : Sysc_tb(name, /*loops=*/1, /*random=*/false) {}
+};
+
+int failures = 0;
+
+void Check(bool ok, const std::string &what) {
+  printf("%s: %s\n", ok ? "ok  " : "FAIL", what.c_str());
+  if (!ok) ++failures;
+}
+
+long Size(const std::string &path) {
+  struct stat st;
+  return stat(path.c_str(), &st) == 0 ? static_cast<long>(st.st_size) : -1;
+}
+
+void Write(const std::string &path, const std::string &text) {
+  std::ofstream(path) << text;
+}
+
+}  // namespace
+
+int sc_main(int, char **) {
+  const char *tmp = std::getenv("TEST_TMPDIR");
+  const std::string dir = tmp != nullptr ? tmp : "/tmp";
+  Design design;
+  // SystemC takes no new modules once the simulation has started, so make a testbench for each
+  // trace first. A testbench closes its trace when it goes away.
+  std::vector<std::unique_ptr<Tb>> tbs;
+  for (int i = 0; i < 6; ++i) tbs.push_back(std::make_unique<Tb>(("tb" + std::to_string(i)).c_str()));
+  auto trace = [&](int tb, const std::string &path, const std::vector<std::string> &select,
+                   bool catalog = false) {
+    return tbs[tb]->trace(&design, path.c_str(), select, catalog);
+  };
+
+  std::vector<std::string> names;
+  Write(dir + "/ok.select",
+        "hwfrp-verilator-select 1\nproducer sim fst\nselect VFake.core Fake s3\n"
+        "select VFake.core Fake s4\n");
+  Check(Sysc_tb::ReadTraceSelection(dir + "/ok.select", &names) && names.size() == 2 &&
+            names[0] == "VFake.core Fake s3" && names[1] == "VFake.core Fake s4",
+        "a manifest is read, names with dots and spaces whole");
+  const char *bad[][2] = {{"version", "hwfrp-verilator-select 2\nselect a b\n"},
+                          {"empty", "hwfrp-verilator-select 1\nproducer sim fst\n"},
+                          {"line", "hwfrp-verilator-select 1\nselects a b\n"},
+                          {"header", "select a b\n"}};
+  for (const auto &item : bad) {
+    names.clear();
+    Write(dir + "/bad.select", item[1]);
+    Check(!Sysc_tb::ReadTraceSelection(dir + "/bad.select", &names),
+          std::string("rejected: ") + item[0]);
+  }
+  names.clear();
+  Check(!Sysc_tb::ReadTraceSelection(dir + "/missing.select", &names), "rejected: no file");
+
+  const std::string all = dir + "/all.fst", some = dir + "/some.fst", none = dir + "/none.fst";
+  const std::string catalog = dir + "/catalog.fst", suffix = dir + "/suffix";
+  Check(trace(0, all, {}), "a full trace opens");
+  Check(trace(1, some, {"VFake.core Fake s3", "VFake.core Fake s250"}), "a selection opens");
+  Check(!trace(2, none, {"VFake.core Fake s3", "VFake.core Fake nope"}), "an unmatched name fails");
+  Check(Size(none) < 0, "and leaves no file");
+  Check(!trace(3, none, {"VFake core Fake s3"}), "the dot of a scope name is not a separator");
+  Check(Size(none) < 0, "and leaves no file either");
+  Check(trace(4, catalog, {}, /*catalog=*/true), "a catalog opens");
+  Check(Size(catalog) > 0, "and is written at once");
+  Check(trace(5, suffix, {}), "a path without .fst is accepted");
+
+  tbs.clear();
+  Check(Size(all) > 0 && Size(some) > 0 && Size(some) < Size(all), "the selected file is smaller");
+  Check(Size(catalog) > 0, "the catalog survives the testbench");
+  Check(Size(suffix + ".fst") > 0, "a path without .fst gets the suffix");
+
+  printf("%d failures\n", failures);
+  return failures == 0 ? 0 : 1;
+}
