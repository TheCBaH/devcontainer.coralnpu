+bool CoreMiniAxi_tb::InTcm(uint64_t addr, size_t len) const {
+  constexpr uint64_t itcm_size = KP_itcmSizeKBytes * 1024;
+  constexpr uint64_t dtcm_size = KP_dtcmSizeKBytes * 1024;
+  constexpr uint64_t dtcm_base = (KP_itcmSizeKBytes == 8 && KP_dtcmSizeKBytes == 32) ? 0x10000 : 0x100000;
+  return (addr <= itcm_size && len <= itcm_size - addr) ||
+         (addr >= dtcm_base && addr - dtcm_base <= dtcm_size &&
+          len <= dtcm_size - (addr - dtcm_base));
+}
+
+void CoreMiniAxi_tb::HostTransport(tlm::tlm_generic_payload& trans, sc_time& delay) {
+  if (Xbar::ContainsMemoryRange(trans.get_address(), trans.get_data_length())) {
+    xbar_.b_transport(trans, delay);
+  } else if (InTcm(trans.get_address(), trans.get_data_length())) {
+    tohost_initiator_socket_->b_transport(trans, delay);
+  } else {
+    trans.set_response_status(tlm::TLM_ADDRESS_ERROR_RESPONSE);
+  }
+}
