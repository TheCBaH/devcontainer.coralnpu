+            # Cocotb has no Linux ARM64 wheel at the upstream pin.
+            kwargs["build_file_content"] = kwargs["build_file_content"].replace(
+                "py_library(",
+                'py_library(target_compatible_with = ["@platforms//cpu:x86_64"],',
+            )
+    http_archive(**kwargs)
