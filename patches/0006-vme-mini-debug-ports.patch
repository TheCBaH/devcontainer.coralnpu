+      auto* port = dynamic_cast<sc_out<T>*>(object);
+      if (!port) return false;
+      signals.push_back(std::make_unique<sc_signal<T>>());
+      (*port)(*signals.back());
+      return true;
+    }
+
+    bool BindMatrixPort(sc_core::sc_object* object) {
