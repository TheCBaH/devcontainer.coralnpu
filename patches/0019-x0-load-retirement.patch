diff --git a/hdl/chisel/src/coralnpu/RetirementBufferTest.scala b/hdl/chisel/src/coralnpu/RetirementBufferTest.scala
new file mode 100644
index 00000000..c230971d
--- /dev/null
+++ b/hdl/chisel/src/coralnpu/RetirementBufferTest.scala
@@ -0,0 +1,104 @@
+package coralnpu
+
+import chisel3._
+import chisel3.simulator.scalatest.ChiselSim
+import org.scalatest.freespec.AnyFreeSpec
+
+class RetirementBufferSpec extends AnyFreeSpec with ChiselSim {
+  for (mini <- Seq(true, false)) {
+    s"x0 loads wait for their own completion or fault (mini=$mini)" in {
+      val p = new Parameters
+      p.rawExposeDebugPorts = true
+      simulate(new RetirementBuffer(p, mini)) { dut =>
+        for (i <- 0 until p.instructionLanes) {
+          dut.io.inst(i).valid.poke(false)
+          dut.io.inst(i).ready.poke(true)
+          dut.io.inst(i).bits.addr.poke(0)
+          dut.io.inst(i).bits.inst.poke(0)
+          dut.io.jump(i).poke(false)
+          dut.io.branch(i).poke(false)
+          dut.io.targets(i).poke(0)
+          dut.io.jalrTargets(i).poke(0)
+          dut.io.writeAddrScalar(i).valid.poke(false)
+          dut.io.writeAddrScalar(i).addr.poke(0)
+        }
+        dut.io.writeDataScalar.foreach(_.valid.poke(false))
+        dut.io.writeAddrFloat.foreach(_.valid.poke(false))
+        dut.io.writeDataFloat.foreach(_.foreach(_.valid.poke(false)))
+        dut.io.storeComplete.valid.poke(false)
+        dut.io.loadComplete.valid.poke(false)
+        dut.io.fault.valid.poke(false)
+        dut.clock.step()
+
+        def enqueue(pc: Int): BigInt = {
+          val tag = dut.io.enqPtr.peek().litValue
+          dut.io.inst(0).valid.poke(true)
+          dut.io.inst(0).bits.addr.poke(pc)
+          dut.io.inst(0).bits.inst.poke("h00052003".U) // lw x0, 0(a0)
+          dut.io.writeAddrScalar(0).valid.poke(true)
+          dut.clock.step()
+          dut.io.inst(0).valid.poke(false)
+          dut.io.writeAddrScalar(0).valid.poke(false)
+          tag
+        }
+
+        val first = enqueue(0x100)
+        val second = enqueue(0x100)
+        assert(first != second)
+        dut.clock.step(4)
+        dut.io.empty.expect(false.B)
+        dut.io.nRetired.expect(0)
+
+        // An unrelated ALU write to x0 must not complete either load.
+        dut.io.writeDataScalar(0).valid.poke(true)
+        dut.io.writeDataScalar(0).bits.addr.poke(0)
+        dut.clock.step()
+        dut.io.writeDataScalar(0).valid.poke(false)
+        dut.io.nRetired.expect(0)
+
+        dut.io.loadComplete.valid.poke(true)
+        dut.io.loadComplete.bits.poke(first)
+        dut.clock.step()
+        dut.io.loadComplete.valid.poke(false)
+        dut.io.nRetired.expect(1)
+        dut.clock.step(3)
+        dut.io.empty.expect(false.B)
+        dut.io.nRetired.expect(0)
+
+        dut.io.fault.valid.poke(true)
+        dut.io.fault.bits.decode.poke(false)
+        dut.io.fault.bits.mepc.poke(0x100)
+        dut.io.fault.bits.mcause.poke(5)
+        dut.io.fault.bits.mtval.poke(0x30000004L)
+        dut.clock.step()
+        dut.io.fault.valid.poke(false)
+        dut.io.trapRetired.expect(true.B)
+        dut.clock.step()
+        dut.io.empty.expect(true.B)
+
+        val afterFlush = enqueue(0x200)
+        dut.clock.step(3)
+        dut.io.empty.expect(false.B)
+        dut.io.loadComplete.valid.poke(true)
+        dut.io.loadComplete.bits.poke(afterFlush)
+        dut.clock.step()
+        dut.io.loadComplete.valid.poke(false)
+        dut.io.nRetired.expect(1)
+        dut.io.empty.expect(true.B)
+
+        for (_ <- 0 until 2 * p.retirementBufferSize) {
+          val tag = enqueue(0x200)
+          dut.clock.step(2)
+          dut.io.empty.expect(false.B)
+          dut.io.nRetired.expect(0)
+          dut.io.loadComplete.valid.poke(true)
+          dut.io.loadComplete.bits.poke(tag)
+          dut.clock.step()
+          dut.io.loadComplete.valid.poke(false)
+          dut.io.nRetired.expect(1)
+          dut.io.empty.expect(true.B)
+        }
+      }
+    }
+  }
+}
